# Copy this file to .env and fill in what you have.
# ThreatFox and URLhaus work with no key at all (abuse.ch public API).
# AbuseIPDB needs a free key from https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# Optional: ThreatFox works better with a free Auth-Key (higher rate limit)
# Get one at https://auth.abuse.ch/
THREATFOX_API_KEY=

# How often (in minutes) the background job pulls fresh IOCs
FEED_REFRESH_MINUTES=30

# Flask
SECRET_KEY=change-me-please
FLASK_DEBUG=False
